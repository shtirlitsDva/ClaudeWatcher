<Window x:Class="ClaudeWatcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ClaudeWatcher.ViewModels"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        Width="360"
        SizeToContent="Height"
        MaxHeight="600"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown">

    <Window.DataContext>
        <vm:MainViewModel />
    </Window.DataContext>

    <Border Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="0"
            Opacity="0.95">
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar area -->
            <Border Grid.Row="0"
                    Padding="14,10,14,8"
                    Background="Transparent">
                <TextBlock Text="ClaudeWatcher"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </Border>

            <!-- Session cards area -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="8,0,8,8">
                <ItemsControl ItemsSource="{Binding Sessions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SessionCardViewModel}">
                            <!-- Placeholder card template - will be replaced by SessionCard UserControl in task #4 -->
                            <Border Background="{StaticResource CardBackgroundBrush}"
                                    CornerRadius="6"
                                    Padding="12"
                                    Margin="0,0,0,6"
                                    Cursor="Hand">
                                <Border.Style>
                                    <Style TargetType="Border">
                                        <Style.Triggers>
                                            <Trigger Property="IsMouseOver" Value="True">
                                                <Setter Property="Background"
                                                        Value="{StaticResource CardHoverBrush}" />
                                            </Trigger>
                                        </Style.Triggers>
                                    </Style>
                                </Border.Style>
                                <StackPanel>
                                    <TextBlock Text="{Binding Title}"
                                               FontWeight="SemiBold"
                                               FontSize="14" />
                                    <TextBlock Text="{Binding Message}"
                                               Foreground="{StaticResource MutedTextBrush}"
                                               FontSize="12"
                                               TextWrapping="Wrap"
                                               MaxHeight="40"
                                               TextTrimming="CharacterEllipsis"
                                               Margin="0,4,0,0" />
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state (visible when no sessions) -->
            <TextBlock Grid.Row="1"
                       Text="No active sessions"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,30"
                       Visibility="{Binding HasSessions, Converter={StaticResource InverseBoolToVisibility}}" />
        </Grid>
    </Border>
</Window>
