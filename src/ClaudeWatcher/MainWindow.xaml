<Window x:Class="ClaudeWatcher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:ClaudeWatcher.ViewModels"
        xmlns:views="clr-namespace:ClaudeWatcher.Views"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        Topmost="True"
        Width="360"
        SizeToContent="Height"
        MaxHeight="600"
        ShowInTaskbar="False"
        ResizeMode="NoResize"
        MouseLeftButtonDown="Window_MouseLeftButtonDown"
        MouseRightButtonUp="Window_RightClick">

    <Border Background="{StaticResource WindowBackgroundBrush}"
            BorderBrush="{StaticResource BorderBrush}"
            BorderThickness="1"
            CornerRadius="8"
            Padding="0"
            Opacity="0.95">

        <Border.ContextMenu>
            <ContextMenu Background="#1E1E2E" BorderBrush="#2A2A3E" Foreground="#E0E0E0">
                <MenuItem Header="Recent Sessions"
                          ItemsSource="{Binding RecentSessions}"
                          Foreground="#E0E0E0">
                    <MenuItem.ItemContainerStyle>
                        <Style TargetType="MenuItem">
                            <Setter Property="Header"
                                    Value="{Binding ProjectName}" />
                            <Setter Property="Command"
                                    Value="{Binding DataContext.LaunchRecentSessionCommand, RelativeSource={RelativeSource AncestorType=ContextMenu}}" />
                            <Setter Property="CommandParameter" Value="{Binding}" />
                            <Setter Property="Foreground" Value="#E0E0E0" />
                        </Style>
                    </MenuItem.ItemContainerStyle>
                </MenuItem>
                <MenuItem Header="New Session..."
                          Command="{Binding NewSessionCommand}"
                          Foreground="#E0E0E0" />
                <Separator Background="#2A2A3E" />
                <MenuItem Header="Launch on Startup"
                          IsCheckable="True"
                          IsChecked="{Binding LaunchOnStartup}"
                          Foreground="#E0E0E0" />
                <Separator Background="#2A2A3E" />
                <MenuItem Header="Minimize to Tray"
                          Click="MinimizeToTray_Click"
                          Foreground="#E0E0E0" />
                <MenuItem Header="Exit"
                          Click="Exit_Click"
                          Foreground="#E0E0E0" />
            </ContextMenu>
        </Border.ContextMenu>

        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <!-- Title bar area -->
            <Border Grid.Row="0"
                    Padding="14,10,14,8"
                    Background="Transparent">
                <TextBlock Text="ClaudeWatcher"
                           FontSize="12"
                           FontWeight="SemiBold"
                           Foreground="{StaticResource SecondaryTextBrush}" />
            </Border>

            <!-- Session cards area -->
            <ScrollViewer Grid.Row="1"
                          VerticalScrollBarVisibility="Auto"
                          HorizontalScrollBarVisibility="Disabled"
                          Padding="8,0,8,8">
                <ItemsControl ItemsSource="{Binding Sessions}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type vm:SessionCardViewModel}">
                            <views:SessionCard DataContext="{Binding}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>

            <!-- Empty state -->
            <TextBlock Grid.Row="1"
                       Text="No active sessions"
                       Foreground="{StaticResource SecondaryTextBrush}"
                       FontSize="12"
                       HorizontalAlignment="Center"
                       Margin="0,20,0,30"
                       Visibility="{Binding HasSessions, Converter={StaticResource InverseBoolToVisibility}}" />
        </Grid>
    </Border>
</Window>
