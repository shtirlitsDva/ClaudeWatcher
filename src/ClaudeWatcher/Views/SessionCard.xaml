<UserControl x:Class="ClaudeWatcher.Views.SessionCard"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="clr-namespace:ClaudeWatcher.ViewModels">

    <Border x:Name="CardBorder"
            CornerRadius="6"
            Background="{StaticResource CardBackgroundBrush}"
            Margin="0,0,0,6"
            Cursor="Hand"
            ClipToBounds="True"
            MouseLeftButtonUp="Card_Click">
        <Border.Style>
            <Style TargetType="Border">
                <Style.Triggers>
                    <Trigger Property="IsMouseOver" Value="True">
                        <Setter Property="Background" Value="{StaticResource CardHoverBrush}" />
                    </Trigger>
                </Style.Triggers>
            </Style>
        </Border.Style>

        <Grid>
            <!-- Context usage background fill -->
            <Border Background="{Binding ContextBackgroundBrush}" />

            <!-- Content -->
            <Grid Margin="12">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Row 0: Status + Title + Model + Time -->
            <DockPanel Grid.Row="0">
                <!-- Status indicator -->
                <Grid Width="14" Height="14" Margin="0,0,8,0" DockPanel.Dock="Left"
                      VerticalAlignment="Center">
                    <!-- Working: spinning arc -->
                    <Path x:Name="SpinnerPath"
                          Data="M 7,1 A 6,6 0 1 1 1,7"
                          Stroke="{StaticResource BlueAccentBrush}"
                          StrokeThickness="2"
                          StrokeStartLineCap="Round"
                          StrokeEndLineCap="Round"
                          RenderTransformOrigin="0.5,0.5"
                          Visibility="Collapsed">
                        <Path.RenderTransform>
                            <RotateTransform x:Name="SpinnerRotation" />
                        </Path.RenderTransform>
                    </Path>

                    <!-- Tool: crossed spanner/hammer icon -->
                    <Path x:Name="ToolIcon"
                          Data="M 3,1 L 5,5 L 1,9 L 3,11 L 7,7 L 9,9 L 11,7 L 9,5 L 13,1 L 11,1 L 9,3 L 7,1 Z"
                          Fill="{StaticResource BlueAccentBrush}"
                          Stretch="Uniform"
                          Width="12" Height="12"
                          Visibility="Collapsed" />

                    <!-- Permission: yellow exclamation in rectangle -->
                    <Grid x:Name="PermissionIcon" Visibility="Collapsed">
                        <Border Background="{StaticResource YellowAccentBrush}"
                                CornerRadius="2" Width="12" Height="12" />
                        <TextBlock Text="!" FontWeight="Bold" FontSize="10"
                                   Foreground="#1E1E2E"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"
                                   Margin="0,-1,0,0" />
                    </Grid>

                    <!-- Waiting: flashing yellow dot -->
                    <Ellipse x:Name="WaitingDot"
                             Width="10" Height="10"
                             Fill="{StaticResource YellowAccentBrush}"
                             Visibility="Collapsed" />

                    <!-- Error: solid red dot -->
                    <Ellipse x:Name="ErrorDot"
                             Width="10" Height="10"
                             Fill="{StaticResource RedAccentBrush}"
                             Visibility="Collapsed" />

                    <!-- Idle: solid green dot -->
                    <Ellipse x:Name="IdleDot"
                             Width="10" Height="10"
                             Fill="{StaticResource GreenAccentBrush}"
                             Visibility="Collapsed" />
                </Grid>

                <!-- Subagent spinners -->
                <ItemsControl x:Name="SubagentSpinners"
                              DockPanel.Dock="Left"
                              Margin="0,0,4,0"
                              VerticalAlignment="Center"
                              Visibility="Collapsed">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <StackPanel Orientation="Horizontal" />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Path Data="M 5,0.5 A 4,4 0 1 1 0.5,5"
                                  Stroke="{StaticResource BlueAccentBrush}"
                                  StrokeThickness="1.5"
                                  StrokeStartLineCap="Round"
                                  StrokeEndLineCap="Round"
                                  Width="10" Height="10"
                                  Stretch="Uniform"
                                  Margin="0,0,2,0"
                                  RenderTransformOrigin="0.5,0.5">
                                <Path.RenderTransform>
                                    <RotateTransform x:Name="SubSpinnerRotation" />
                                </Path.RenderTransform>
                                <Path.Triggers>
                                    <EventTrigger RoutedEvent="Loaded">
                                        <BeginStoryboard>
                                            <Storyboard>
                                                <DoubleAnimation
                                                    Storyboard.TargetName="SubSpinnerRotation"
                                                    Storyboard.TargetProperty="Angle"
                                                    From="0" To="360"
                                                    Duration="0:0:1.2"
                                                    RepeatBehavior="Forever" />
                                            </Storyboard>
                                        </BeginStoryboard>
                                    </EventTrigger>
                                </Path.Triggers>
                            </Path>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>

                <!-- Elapsed time (right) -->
                <TextBlock DockPanel.Dock="Right"
                           Text="{Binding ElapsedTime}"
                           Foreground="{StaticResource SecondaryTextBrush}"
                           FontSize="11"
                           VerticalAlignment="Center"
                           Margin="6,0,0,0" />

                <!-- Model badge (right) -->
                <Border DockPanel.Dock="Right"
                        CornerRadius="3"
                        Background="{StaticResource SurfaceBrush}"
                        Padding="5,1"
                        VerticalAlignment="Center"
                        Visibility="{Binding ModelName, Converter={StaticResource StringToVisibility}}">
                    <TextBlock Text="{Binding ModelName}"
                               FontSize="10"
                               Foreground="{StaticResource SecondaryTextBrush}" />
                </Border>

                <!-- Title -->
                <TextBlock Text="{Binding Title}"
                           FontWeight="SemiBold"
                           FontSize="14"
                           Foreground="{StaticResource PrimaryTextBrush}"
                           TextTrimming="CharacterEllipsis"
                           VerticalAlignment="Center" />
            </DockPanel>

            <!-- Row 1: Message -->
            <TextBlock Grid.Row="1"
                       Text="{Binding DisplayMessage}"
                       Foreground="{StaticResource MutedTextBrush}"
                       FontSize="12"
                       TextWrapping="Wrap"
                       MaxHeight="40"
                       TextTrimming="CharacterEllipsis"
                       Margin="22,4,0,0" />

        </Grid>
        </Grid>
    </Border>
</UserControl>
